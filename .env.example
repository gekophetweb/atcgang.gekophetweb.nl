# Copy to .env on the host. Never commit .env.
# Lets plain `docker compose ...` in this folder find the stack file.
COMPOSE_FILE=deploy/docker-compose.yml

BASE_URL=https://atcgang.gekophetweb.nl

POSTGRES_USER=atc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atc
# Used when running the server outside Docker (pnpm dev:server). Inside compose it is derived from POSTGRES_*.
DATABASE_URL=postgres://atc:change-me@localhost:5432/atc

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudflare Tunnel: public hostname atcgang.gekophetweb.nl -> http://web:3000
TUNNEL_TOKEN=

PHOTO_DIR=/data/photos
STORAGE_QUOTA_BYTES=2147483648

RESEND_API_KEY=
MAIL_FROM=ATC Gang <noreply@gekophetweb.nl>

# Cloudflare Turnstile (on "send login code"). Leave empty to disable (dev).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SSO - callback URLs: ${BASE_URL}/api/auth/callback/{google|microsoft|apple|github}
# A provider is enabled only when its variables are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Entra ID app registration, tenant "common"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Apple: Services ID, team id, key id and the .p8 key contents (newlines as \n).
# The client-secret JWT is generated from the key at startup, so it never silently expires.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# GitHub OAuth App (not a GitHub App), scope user:email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Backups (restic): off-site repo (B2 or R2) + a local copy
RESTIC_REPOSITORY=s3:https://ACCOUNT.r2.cloudflarestorage.com/atcgang-backup
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Relative to deploy/ (the compose file's folder): ../backups is the backups/ folder next to this .env.
BACKUP_LOCAL_DIR=../backups
