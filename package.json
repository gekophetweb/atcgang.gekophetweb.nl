{
  "name": "atcgang",
  "version": "1.0.0",
  "description": "Concert tracker: atcgang.gekophetweb.nl",
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "dependencies": {
    "@better-auth/cimd": "^1.7.27",
    "@better-auth/drizzle-adapter": "^1.7.27",
    "@better-auth/mcp": "^1.7.27",
    "@better-auth/oauth-provider": "^1.7.27",
    "@fullcalendar/core": "^7.1.5",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^7.1.5",
    "@fullcalendar/timegrid": "^6.1.22",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "hono": "^4.13.20",
    "jose": "^6.2.18",
    "pg-boss": "^12.39.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
